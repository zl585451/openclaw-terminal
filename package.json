{
  "name": "openclaw-terminal",
  "version": "0.2.7",
  "author": {
    "name": "OCT Team",
    "email": "release@openclaw.local"
  },
  "description": "OpenClaw Terminal - Windows 超级系统助手",
  "main": "dist-electron/main.js",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24 <25"
  },
  "volta": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.js",
    "init": "node scripts/init-user-config.js",
    "postinstall": "echo skip rebuild",
    "dev": "npm run check:node && vite",
    "rebuild:gateway:native": "node scripts/rebuild-oct-gateway-native.js",
    "build:electron": "npx -p typescript tsc -p tsconfig.electron.json",
    "build": "npm run check:node && npx -p typescript tsc && vite build && npm run build:electron",
    "start": "npm run check:node && npm run build:electron && concurrently \"npm run dev\" \"wait-on http://localhost:5176 && cross-env NODE_ENV=development electron .\"",
    "start:fast": "npm run check:node && concurrently \"npm run dev\" \"wait-on http://localhost:5176 && cross-env NODE_ENV=development electron .\"",
    "electron:dev": "npm run check:node && npm run build:electron && concurrently \"npm run dev\" \"wait-on http://localhost:5176 && cross-env NODE_ENV=development electron .\"",
    "electron:build:win": "npm run rebuild:gateway:native && npm run build && electron-builder --win --x64",
    "electron:build:win:nolocal": "npm run rebuild:gateway:native && npm run build && electron-builder --win --x64",
    "electron:build:mac": "npm run rebuild:gateway:native && npm run build && electron-builder --mac --x64 --arm64",
    "electron:build:linux": "npm run rebuild:gateway:native && npm run build && electron-builder --linux --x64",
    "electron:build:all": "npm run rebuild:gateway:native && npm run build && electron-builder --win --mac --linux --x64",
    "test": "npm run check:node && vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.openclaw.terminal",
    "productName": "OCT OpenClaw Terminal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/float.html",
      "electron/code-window.html",
      "electron/terminal-window.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "oct-gateway/node_modules",
        "to": "oct-gateway/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "oct-gateway",
        "to": "oct-gateway",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/.temp/**",
          "!**/docs/**",
          "!**/$null",
          "!**/tasks_runtime.json",
          "!**/*.log"
        ]
      },
      {
        "from": "docs/01_system_prompts",
        "to": "prompts",
        "filter": [
          "**/*",
          "!USER.md"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "OCT-Setup-v${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "artifactName": "OCT-${version}-Mac-${arch}.dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "OCT-${version}-Linux-${arch}.${ext}",
      "category": "Development",
      "synopsis": "OpenClaw Terminal - AI Desktop Assistant",
      "maintainer": "OCT Team <release@openclaw.local>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OCT Terminal"
    },
    "npmRebuild": true,
    "nativeRebuilder": "legacy"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@types/prismjs": "^1.26.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xyflow/react": "^12.10.2",
    "docx": "^9.6.1",
    "dotenv": "^16.6.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "katex": "^0.16.45",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "node-pty": "^1.1.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "undici": "^6.24.1",
    "ws": "^8.20.0",
    "xterm": "^5.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "chokidar": "^3.6.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "decode-ico": "^0.4.1",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "icon-gen": "^5.0.0",
    "javascript-obfuscator": "^5.3.0",
    "jsdom": "^29.1.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^4.1.0",
    "wait-on": "^7.2.0"
  }
}
