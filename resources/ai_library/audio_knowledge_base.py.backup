def check_paddleocr():
    global HAS_PADDLEOCR
    if HAS_PADDLEOCR is None:
        try:
            from paddleocr import PaddleOCR
            HAS_PADDLEOCR = True
        except ImportError:
            HAS_PADDLEOCR = False
    return HAS_PADDLEOCR


