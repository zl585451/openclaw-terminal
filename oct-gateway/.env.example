# === 摘要系统（L2/L1/L0 三级摘要）===
# 启用开关
SUMMARIZER_ENABLED=true

# 摘要专用 API（独立于主对话模型，兼容 OpenAI 协议）
# 示例：OpenRouter 跑 Claude
SUMMARIZER_BASE_URL=https://openrouter.ai/api/v1
SUMMARIZER_API_KEY=sk-or-v1-xxxxx
SUMMARIZER_MODEL=anthropic/claude-3.5-sonnet

# 其他可选供应商示例：
# DeepSeek:  SUMMARIZER_BASE_URL=https://api.deepseek.com/v1
# Kimi:      SUMMARIZER_BASE_URL=https://api.moonshot.cn/v1
# 智谱:       SUMMARIZER_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# === P3 向量召回系统 ===
# 默认关闭；配置完成并回填验证后再打开
VECTOR_RECALL_ENABLED=false

# Embedding API（OpenAI embeddings 兼容协议）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_VERSION=1

# 默认放在 ~/.openclaw/vector_recall/vectors.db，不提交 git
VECTOR_DB_PATH=

# 召回参数
VECTOR_RECALL_THRESHOLD=0.75
VECTOR_RECALL_TOP_K=3
VECTOR_RECALL_MAX_LATENCY=2000
