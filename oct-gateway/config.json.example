{
  "AI_LIBRARY_URL": "http://127.0.0.1:8001",
  "GOOGLE_HTTPS_PROXY": "",
  "GOOGLE_TOOLS_MODE": "auto",
  "memory": {
    "auto_save_history": true,
    "auto_save_feedback": true,
    "enable_memory_search": true,
    "search_cache_ttl": 300,
    "search_default_limit": 10,
    "max_history_days": 7,
    "max_feedback_days": 7,
    "load_feedback_on_boot": true,
    "compress_length": {
      "user": 100,
      "amy": 200
    }
  }
}

// ═══════════════════════════════════════
// 多平台切换说明（通过环境变量）
// ═══════════════════════════════════════
//
// 在 .env 文件中设置以下变量即可切换平台：
//
// 【阿里云百炼 Coding Plan】（默认）
// DASHSCOPE_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
// OCT_MODEL=qwen3.5-plus
//
// 【阿里云百炼标准版】
// DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
// OCT_MODEL=qwen-plus
//
// 【DeepSeek】
// DASHSCOPE_API_KEY=你的DeepSeek Key
// DASHSCOPE_BASE_URL=https://api.deepseek.com/v1
// OCT_MODEL=deepseek-v4-flash
//
// 【OpenAI】
// DASHSCOPE_API_KEY=你的OpenAI Key
// DASHSCOPE_BASE_URL=https://api.openai.com/v1
// OCT_MODEL=gpt-4o
//
// 【Groq】（速度极快）
// DASHSCOPE_API_KEY=你的Groq Key
// DASHSCOPE_BASE_URL=https://api.groq.com/openai/v1
// OCT_MODEL=llama-3.3-70b-versatile
//
// 【火山引擎（字节跳动）】
// DASHSCOPE_API_KEY=你的火山Key
// DASHSCOPE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
// OCT_MODEL=你的模型ID
//
// 【Ollama 本地】（完全离线）
// DASHSCOPE_API_KEY=ollama
// DASHSCOPE_BASE_URL=http://localhost:11434/v1
// OCT_MODEL=qwen2.5:7b
