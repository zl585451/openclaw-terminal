{
  "OCT_MODEL": "MiniMax-M2.7",
  "GOOGLE_AI_API_KEY": "",
  "GOOGLE_AI_BASE_URL": "https://aiplatform.googleapis.com/v1beta1/projects/gemini-key-493216/locations/us-central1/endpoints/openapi",
  "GOOGLE_HTTPS_PROXY": "http://127.0.0.1:10808",
  "GOOGLE_TOOLS_MODE": "on",
  "CUSTOM_MODEL_SUPPORTS_TOOLS": true,
  "MINIMAX_TEMPERATURE": 0.7,
  "memory": {
    "auto_save_history": true,
    "auto_save_feedback": true,
    "enable_memory_search": true,
    "search_cache_ttl": 1800,
    "search_default_limit": 10,
    "max_history_days": 7,
    "max_feedback_days": 7,
    "load_feedback_on_boot": true,
    "compress_length": {
      "user": 100,
      "amy": 200
    }
  },
  "nocturne": {
    "heartbeat_interval_seconds": 300,
    "NOCTURNE_BUSY_TIMEOUT": 10000,
    "read_retry": {
      "count": 3,
      "interval_ms": 500
    },
    "write_retry": {
      "count": 3,
      "interval_ms": 500
    }
  },
  "stream_merge": {
    "min_chars": 1,
    "max_chars": 2,
    "idle_ms": 16
  },
  "ai_library": {
    "enabled": true,
    "url": "http://127.0.0.1:8001",
    "timeout_ms": 3000,
    "default_top_k": 3
  },
  "scriptAdapter": {
    "_comment": "有声书台本 Agent 配置。realAgents: 'off'=全 mock, 'all'=全部真实 LLM, 'agent-id1,agent-id2'=指定 agent。textPipeline 默认 span_attribution；如需旧链路可设 classify_first。baseUrl/apiKey/model 留空时复用主 gateway provider。",
    "realAgents": "off",
    "baseUrl": "",
    "apiKey": "",
    "model": "",
    "textPipeline": "span_attribution"
  },
  "AGENT_PERMISSIONS": {
    "shellCommands": false,
    "fileWrite": false,
    "networkRequests": true,
    "softwareInstall": false,
    "systemConfig": false
  },
  "AGENT_PERMISSIONS_STRICT_UNKNOWN_MCP_DENY": true,
  "mcpServers": {
    "file_ops": {
      "command": "node",
      "args": [
        "mcp-servers/oct-file-ops/src/index.js"
      ],
      "env": {
        "OCT_FILE_OPS_UNSAFE_ALLOW_ALL": "0",
        "OCT_FILE_OPS_ALLOWED_ROOTS": ""
      }
    }
  },
  "minimax": {
    "api_key": ""
  }
}
