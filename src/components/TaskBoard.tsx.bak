import React, { useState, useEffect, useCallback, useRef } from 'react';
import '../styles/TaskBoard.css';

const ipcRenderer =
  typeof window !== 'undefined' && typeof (window as any).require === 'function'
    ? (window as any).require('electron').ipcRenderer
    : {
        invoke: () => Promise.resolve(null),
        on: () => {},
        off: () => {},
        removeListener: () => {},
      };

export interface TaskItem {
  id: string;
  content: string;
  priority: 'p0' | 'p1' | 'p2';
  done: boolean;
  source: 'amy' | 'user';
  createdAt: string;
}

interface TaskBoardProps {
  visible?: boolean;
  onClose?: () => void;
  /** 紧凑模式：用于右侧面板内嵌显示 */
  compact?: boolean;
}

const PRIORITY_LABELS: Record<string, { icon: string; label: string; color: string }> = {
  p0: { icon: '🔴', label: 'P0', color: '#ff4444' },
  p1: { icon: '🟡', label: 'P1', color: '#ffaa00' },
  p2: { icon: '🟢', label: 'P2', color: '#00cc66' },
};

function getTodayStr(): string {
  return new Date().toISOString().slice(0, 10);
}

function formatDateDisplay(dateStr: string): string {
  const d = new Date(dateStr);
  const weekdays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  const wd = weekdays[d.getDay()];
  return `${y}.${m}.${day} ${wd}`;
}

const TaskBoard: React.FC<TaskBoardProps> = ({ visible = true, onClose, compact = false }) => {
  const [tasks, setTasks] = useState<TaskItem[]>([]);
  const [parkingLot, setParkingLot] = useState<TaskItem[]>([]);
  const [intention, setIntention] = useState<string>('');
  const [loading, setLoading] = useState(true);
  const [newTaskContent, setNewTaskContent] = useState('');
  const [newTaskPriority, setNewTaskPriority] = useState<'p0' | 'p1' | 'p2'>('p2');
  const [showAddForm, setShowAddForm] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);
  const refreshTimerRef = useRef<ReturnType<typeof setInterval> | null>(null);

  // 加载今日任务 - 直接读取 Nocturne 数据
  const loadTasks = useCallback(async () => {
    const todayStr = new Date().toISOString().slice(0, 10);
    try {
      // 第一步：读取 tasks 父节点，获取子节点列表
      const result = await ipcRenderer.invoke(
        'nocturne-read',
        { uri: `core://my_user/daily/${todayStr}/tasks` }
      );
      
      // 打印调试信息
      console.log('[TaskBoard] 读取结果:', JSON.stringify(result).slice(0, 500));
      
      // 尝试多种可能的数据结构
      const children = 
        result?.data?.node?.children ||
        result?.data?.children ||
        result?.data?.node?.nodes ||
        result?.data?.nodes ||
        [];
      
      console.log('[TaskBoard] children 数量:', children.length);
      
      let taskChildren = children;
      
      // 如果没有 children，尝试使用 nav_only 参数
      if (children.length === 0) {
        console.log('[TaskBoard] 尝试 nav_only 模式读取...');
        const navResult = await ipcRenderer.invoke(
          'nocturne-read',
          { uri: `core://my_user/daily/${todayStr}/tasks`, nav_only: true }
        );
        console.log('[TaskBoard] nav_only 结果:', JSON.stringify(navResult).slice(0, 500));
        
        taskChildren = 
          navResult?.data?.node?.children ||
          navResult?.data?.children ||
          navResult?.data?.node?.nodes ||
          navResult?.data?.nodes ||
          [];
        
        console.log('[TaskBoard] nav_only children 数量:', taskChildren.length);
      }
      
      // 如果仍然没有 children，尝试搜索
      if (taskChildren.length === 0) {
        console.log('[TaskBoard] 尝试搜索任务...');
        const searchResult = await ipcRenderer.invoke(
          'nocturne-search',
          { query: `daily/${todayStr}/tasks` }
        );
        console.log('[TaskBoard] 搜索结果:', JSON.stringify(searchResult).slice(0, 500));
        
        // 解析搜索结果
        const searchNodes = 
          searchResult?.data?.results ||
          searchResult?.data?.nodes ||
          searchResult?.results ||
          [];
        
        if (searchNodes.length > 0) {
          taskChildren = searchNodes.map((n: any) => ({
            uri: n.uri || n.path,
            path: n.path || n.uri?.replace(/^core:\/\//, ''),
          }));
          console.log('[TaskBoard] 搜索结果转换 children:', taskChildren.length);
        }
      }
      
      const taskList = [];
      for (const child of taskChildren) {
        const childUri = child.uri || 
          `core://${child.path || ''}`;
        if (!childUri || childUri === 'core://') continue;
        
        console.log('[TaskBoard] 读取任务:', childUri);
        
        const taskData = await ipcRenderer.invoke(
          'nocturne-read', { uri: childUri }
        );
        
        const content = 
          taskData?.data?.node?.content ||
          taskData?.data?.content || '';
        
        console.log('[TaskBoard] 任务内容:', childUri, content.slice(0, 100));
        
        try {
          const parsed = JSON.parse(content);
          taskList.push({
            id: childUri,
            content: parsed.label || parsed.item || '未命名任务',
            priority: parsed.priority || 'p2',
            done: parsed.done || false,
            source: 'amy',
            createdAt: parsed.created || '',
          });
        } catch {
          // 如果不是 JSON，直接用内容作为 label
          if (content) {
            taskList.push({
              id: childUri,
              content: content.slice(0, 50),
              priority: 'p2',
              done: false,
              source: 'user',
              createdAt: '',
            });
          }
        }
      }
      
      // 排序：p0 在前，done 在后
      taskList.sort((a, b) => {
        if (a.done !== b.done) return a.done ? 1 : -1;
        const order = { p0: 0, p1: 1, p2: 2 };
        return (order[a.priority] || 2) - (order[b.priority] || 2);
      });
      
      console.log('[TaskBoard] 最终任务列表:', taskList.length);
      setTasks(taskList);
      
      // 加载意图
      const intentionData = await ipcRenderer.invoke(
        'nocturne-read',
        { uri: `core://my_user/daily/${todayStr}/intention` }
      );
      const intentionContent = intentionData?.data?.node?.content 
        || intentionData?.data?.content 
        || '';
      setIntention(intentionContent);
      
      // 加载停车场
      const parkingRoot = await ipcRenderer.invoke(
        'nocturne-read',
        { uri: `core://my_user/daily/${todayStr}/parking_lot` }
      );
      
      // 同样处理停车场的多种数据结构
      let parkingChildren = 
        parkingRoot?.data?.node?.children ||
        parkingRoot?.data?.children ||
        parkingRoot?.data?.node?.nodes ||
        parkingRoot?.data?.nodes ||
        [];
      
      // 尝试 nav_only
      if (parkingChildren.length === 0) {
        const parkingNav = await ipcRenderer.invoke(
          'nocturne-read',
          { uri: `core://my_user/daily/${todayStr}/parking_lot`, nav_only: true }
        );
        parkingChildren = 
          parkingNav?.data?.node?.children ||
          parkingNav?.data?.children ||
          parkingNav?.data?.node?.nodes ||
          parkingNav?.data?.nodes ||
          [];
      }
      
      const parkingList = [];
      for (const child of parkingChildren) {
        const childUri = child.uri || 
          `core://${child.path || ''}`;
        if (!childUri || childUri === 'core://') continue;
        
        const itemData = await ipcRenderer.invoke(
          'nocturne-read', { uri: childUri }
        );
        
        const content = 
          itemData?.data?.node?.content ||
          itemData?.data?.content || '';
        
        try {
          const parsed = JSON.parse(content);
          parkingList.push({
            id: childUri,
            content: parsed.item || content.slice(0, 50),
            priority: 'p2',
            done: parsed.done || false,
            source: 'amy',
            createdAt: parsed.time || '',
          });
        } catch {
          if (content) {
            parkingList.push({
              id: childUri,
              content: content.slice(0, 50),
              priority: 'p2',
              done: false,
              source: 'user',
              createdAt: '',
            });
          }
        }
      }
      setParkingLot(parkingList);
    } catch (e) {
      console.error('[TaskBoard] 加载失败:', e);
    } finally {
      setLoading(false);
    }
  }, []);

  // 初始加载 + 定时刷新
  useEffect(() => {
    loadTasks();
    refreshTimerRef.current = setInterval(loadTasks, 30000); // 30秒刷新
    return () => {
      if (refreshTimerRef.current) {
        clearInterval(refreshTimerRef.current);
      }
    };
  }, [loadTasks]);

  // 监听任务更新事件（AMY 写入新任务时触发）
  useEffect(() => {
    const onTaskUpdate = () => {
      loadTasks();
    };
    ipcRenderer.on('task-board-update', onTaskUpdate);
    return () => {
      ipcRenderer.removeListener('task-board-update', onTaskUpdate);
    };
  }, [loadTasks]);

  // 切换任务完成状态（带 Nocturne 持久化）
  const toggleTask = useCallback(async (taskId: string) => {
    let original: TaskItem | undefined;
    // 乐观更新 UI
    setTasks(prev => {
      original = prev.find(t => t.id === taskId);
      if (!original) return prev;
      const newDone = !original.done;
      return prev.map(t => t.id === taskId ? { ...t, done: newDone } : t);
    });

    if (!original) return;
    const newDone = !original.done;

    try {
      await ipcRenderer.invoke('nocturne-update', {
        uri: taskId,
        content: JSON.stringify({
          label: original.content,
          priority: original.priority,
          done: newDone,
          created: original.createdAt,
        }),
      });
    } catch (e) {
      console.error('[TaskBoard] 更新任务失败:', e);
      // 写入失败时回滚 UI
      const snapshot = original;
      setTasks(prev =>
        prev.map(t =>
          t.id === taskId ? { ...t, done: snapshot.done } : t
        )
      );
    }
  }, []);

  // 添加新任务
  const addTask = useCallback(async () => {
    const content = newTaskContent.trim();
    if (!content) return;

    const newTask: TaskItem = {
      id: `${Date.now()}`,
      content,
      priority: newTaskPriority,
      done: false,
      source: 'user',
      createdAt: new Date().toISOString(),
    };

    // 乐观更新
    setTasks(prev => [...prev, newTask]);
    setNewTaskContent('');
    setShowAddForm(false);

    try {
      await ipcRenderer.invoke('nocturne-add-task', {
        content,
        priority: newTaskPriority,
        source: 'user',
      });
      // 刷新以获取真实 ID
      loadTasks();
    } catch (e) {
      console.error('[TaskBoard] 添加任务失败:', e);
    }
  }, [newTaskContent, newTaskPriority, loadTasks]);

  // 清空已完成任务
  const clearCompleted = useCallback(async () => {
    const completedIds = tasks.filter(t => t.done).map(t => t.id);
    if (completedIds.length === 0) return;

    setTasks(prev => prev.filter(t => !t.done));
    try {
      await ipcRenderer.invoke('nocturne-clear-completed-tasks');
    } catch (e) {
      console.error('[TaskBoard] 清空已完成任务失败:', e);
    }
  }, [tasks]);

  // 键盘快捷键
  useEffect(() => {
    if (!showAddForm) return;
    const handleKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        setShowAddForm(false);
        setNewTaskContent('');
      }
    };
    window.addEventListener('keydown', handleKey);
    return () => window.removeEventListener('keydown', handleKey);
  }, [showAddForm]);

  useEffect(() => {
    if (showAddForm && inputRef.current) {
      inputRef.current.focus();
    }
  }, [showAddForm]);

  if (!visible) return null;

  const pendingTasks = tasks.filter(t => !t.done);
  const completedTasks = tasks.filter(t => t.done);
  const doneCount = completedTasks.length;
  const totalCount = tasks.length;

  // 紧凑模式渲染
  if (compact) {
    return (
      <div className="task-board-compact">
        {/* 标题行 */}
        <div className="task-board-header-compact">
          <span>◈ 任务</span>
          <span>{doneCount}/{totalCount} 完成</span>
        </div>
        
        {/* 今日意图 */}
        {intention && (
          <div className="task-intention-compact">
            今日：{intention}
          </div>
        )}
        
        {/* 任务列表 */}
        {loading ? (
          <div className="task-loading-compact">加载中...</div>
        ) : pendingTasks.length > 0 ? (
          <div className="task-list-compact">
            {pendingTasks.slice(0, 5).map((task) => (
              <div
                key={task.id}
                className="task-item-compact"
                onClick={() => toggleTask(task.id, task.done)}
              >
                <span style={{
                  fontSize: '10px',
                  fontFamily: 'Share Tech Mono',
                  color: task.priority === 'p0' ? '#ff6666' : 
                         task.priority === 'p1' ? '#ffaa00' : '#00cc6666',
                  flexShrink: 0,
                  minWidth: '28px',
                }}>
                  [{task.priority?.toUpperCase() || 'P2'}]
                </span>
                <span style={{
                  flex: 1,
                  fontSize: '12px',
                  color: task.done ? '#1a4d2a' : '#00cc66',
                  textDecoration: task.done ? 'line-through' : 'none',
                  overflow: 'hidden',
                  textOverflow: 'ellipsis',
                  whiteSpace: 'nowrap',
                }}>
                  {task.content}
                </span>
                <span style={{
                  fontSize: '10px',
                  color: '#00cc6633',
                  flexShrink: 0,
                }}>
                  {task.createdAt?.slice(0, 5) || ''}
                </span>
              </div>
            ))}
            {pendingTasks.length > 5 && (
              <div className="task-more-compact">+{pendingTasks.length - 5} 更多</div>
            )}
          </div>
        ) : (
          <div className="task-empty-compact">暂无待办任务</div>
        )}

        {/* 停车场 */}
        {parkingLot.length > 0 && (
          <div className="parking-section-compact">
            <div className="parking-header-compact">
              停车场 ({parkingLot.length})
            </div>
            {parkingLot.slice(0, 3).map((item, i) => (
              <div key={i} className="parking-item-compact">
                · {item.content}
              </div>
            ))}
            {parkingLot.length > 3 && (
              <div className="task-more-compact">+{parkingLot.length - 3} 更多</div>
            )}
          </div>
        )}
      </div>
    );
  }

  const progress = totalCount > 0 ? Math.round((doneCount / totalCount) * 100) : 0;

  return (
    <div className="task-board">
      {/* 顶部：日期 + 今日意图 */}
      <div className="task-board-header">
        <div className="task-board-date">{formatDateDisplay(getTodayStr())}</div>
        {intention && (
          <div className="task-board-intention">
            <span className="intention-label">今日意图</span>
            <span className="intention-text">{intention}</span>
          </div>
        )}
        {onClose && (
          <button type="button" className="task-board-close" onClick={onClose} title="关闭">
            ×
          </button>
        )}
      </div>

      {/* 进度条 */}
      <div className="task-progress-bar">
        <div className="task-progress-fill" style={{ width: `${progress}%` }} />
        <span className="task-progress-text">{completedTasks.length}/{tasks.length} 完成</span>
      </div>

      {/* 任务列表 */}
      <div className="task-board-content">
        {loading ? (
          <div className="task-board-loading">加载中...</div>
        ) : (
          <>
            {/* 待办任务 */}
            <div className="task-section">
              <div className="task-section-header">
                <span className="task-section-title">待办任务</span>
                <button
                  type="button"
                  className="task-add-btn"
                  onClick={() => setShowAddForm(true)}
                  title="添加任务"
                >
                  + 添加
                </button>
              </div>

              {showAddForm && (
                <div className="task-add-form">
                  <input
                    ref={inputRef}
                    type="text"
                    className="task-add-input"
                    placeholder="输入任务内容..."
                    value={newTaskContent}
                    onChange={(e) => setNewTaskContent(e.target.value)}
                    onKeyDown={(e) => {
                      if (e.key === 'Enter') addTask();
                    }}
                  />
                  <div className="task-add-options">
                    <div className="priority-selector">
                      {(['p0', 'p1', 'p2'] as const).map((p) => (
                        <button
                          key={p}
                          type="button"
                          className={`priority-btn ${newTaskPriority === p ? 'active' : ''}`}
                          onClick={() => setNewTaskPriority(p)}
                          style={{ borderColor: PRIORITY_LABELS[p].color }}
                        >
                          {PRIORITY_LABELS[p].icon}
                        </button>
                      ))}
                    </div>
                    <button type="button" className="task-add-confirm" onClick={addTask}>
                      确认
                    </button>
                  </div>
                </div>
              )}

              {pendingTasks.length === 0 && !showAddForm ? (
                <div className="task-empty">暂无待办任务</div>
              ) : (
                <div className="task-list">
                  {pendingTasks.map((task) => (
                    <div
                      key={task.id}
                      className="task-item"
                      onClick={() => toggleTask(task.id)}
                    >
                      <span className="task-checkbox" />
                      <span className="task-priority" style={{ color: PRIORITY_LABELS[task.priority].color }}>
                        {PRIORITY_LABELS[task.priority].icon}
                      </span>
                      <span className="task-content">{task.content}</span>
                      <span className="task-source">{task.source === 'amy' ? 'AMY' : '少爷'}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>

            {/* 已完成任务 */}
            {completedTasks.length > 0 && (
              <div className="task-section completed">
                <div className="task-section-header">
                  <span className="task-section-title">已完成</span>
                  <button
                    type="button"
                    className="task-clear-btn"
                    onClick={clearCompleted}
                  >
                    清空
                  </button>
                </div>
                <div className="task-list">
                  {completedTasks.map((task) => (
                    <div
                      key={task.id}
                      className="task-item done"
                      onClick={() => toggleTask(task.id)}
                    >
                      <span className="task-checkbox" />
                      <span className="task-priority" style={{ color: PRIORITY_LABELS[task.priority].color }}>
                        {PRIORITY_LABELS[task.priority].icon}
                      </span>
                      <span className="task-content">{task.content}</span>
                      <span className="task-source">{task.source === 'amy' ? 'AMY' : '少爷'}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* 停车场 */}
            {parkingLot.length > 0 && (
              <div className="task-section parking-lot">
                <div className="task-section-header">
                  <span className="task-section-title">🅿️ 停车场</span>
                </div>
                <div className="task-list">
                  {parkingLot.map((item) => (
                    <div key={item.id} className="task-item parking">
                      <span className="parking-icon">🅿️</span>
                      <span className="task-content">{item.content}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </>
        )}
      </div>
    </div>
  );
};

export default TaskBoard;