/* ========================================
   global.css — OCT 全局样式
   所有颜色走 CSS 变量（由 ThemeProvider 注入）
   这里只放主题无关的 reset 和组件基础样式
   ======================================== */

/* Reset */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

html, body, #root {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* Body */
body {
  background: var(--bg-base);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: var(--text-md);
  line-height: 1.6;
  transition: background 0.3s ease, color 0.3s ease;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Selection（修复：确保选择器有效） */
:::selection {
  background: var(--selection-bg);
  color: var(--selection-text);
}

/* 滚动条（修复：确保选择器有效） */
:::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
:::-webkit-scrollbar-track {
  background: var(--scrollbar-track);
}
:::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb);
  border-radius: 3px;
}
:::-webkit-scrollbar-thumb:hover {
  background: var(--scrollbar-thumb-hover);
}

/* Selection */
:::selection {
  background: var(--selection-bg);
  color: var(--selection-text);
}

/* ========================================
   滚动条
   ======================================== */
:::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
:::-webkit-scrollbar-track {
  background: var(--scrollbar-track);
}
:::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb);
  border-radius: 3px;
}
:::-webkit-scrollbar-thumb:hover {
  background: var(--scrollbar-thumb-hover);
}

/* ========================================
   链接
   ======================================== */
a {
  color: var(--text-link);
  text-decoration: none;
  transition: opacity 0.15s;
}
a:hover {
  opacity: 0.8;
}

/* ========================================
   表格 — 无边框设计
   ======================================== */
table {
  border-collapse: collapse;
  width: 100%;
  border: none;
}

thead tr {
  background: var(--bg-panel);
}

th {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--text-tertiary);
  text-align: left;
  padding: 10px 14px;
  border: none;
  border-bottom: 1px solid var(--border-subtle);
  letter-spacing: 0.02em;
}

td {
  padding: 12px 14px;
  font-size: var(--text-base);
  color: var(--text-primary);
  border: none;
  border-bottom: 1px solid var(--border-subtle);
}

tr:last-child td {
  border-bottom: none;
}

tbody tr {
  transition: background 0.1s ease;
}
tbody tr:hover td {
  background: var(--bg-hover);
}

/* 表格容器（可选，用 class 包裹） */
.table-container {
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--bg-surface);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-subtle);
}

/* ========================================
   按钮系统
   ======================================== */
.btn {
  border: none;
  border-radius: var(--radius-lg);
  padding: 8px 18px;
  font-size: var(--text-base);
  font-weight: 500;
  font-family: var(--font-sans);
  cursor: pointer;
  transition: background 0.15s ease, transform 0.1s ease;
  outline: none;
}
.btn:active {
  transform: scale(0.98);
}

.btn-primary {
  background: var(--accent-primary);
  color: var(--text-inverse);
}
.btn-primary:hover {
  background: var(--accent-primary-hover);
}

.btn-secondary {
  background: var(--bg-panel);
  color: var(--text-primary);
}
.btn-secondary:hover {
  background: var(--bg-hover);
}

.btn-ghost {
  background: transparent;
  color: var(--text-secondary);
}
.btn-ghost:hover {
  background: var(--bg-panel);
}

/* 小按钮 */
.btn-sm {
  padding: 5px 12px;
  font-size: var(--text-sm);
  border-radius: var(--radius-md);
}

/* ========================================
   状态标签 (Pill)
   ======================================== */
.pill {
  display: inline-block;
  padding: 2px 10px;
  border-radius: var(--radius-pill);
  font-size: var(--text-xs);
  font-weight: 500;
  border: none;
  line-height: 1.6;
}

.pill-success { background: var(--status-success-bg); color: var(--status-success); }
.pill-warning { background: var(--status-warning-bg); color: var(--status-warning); }
.pill-error   { background: var(--status-error-bg);   color: var(--status-error); }
.pill-info    { background: var(--status-info-bg);     color: var(--status-info); }

/* ========================================
   代码块
   ======================================== */
.code-block {
  border-radius: var(--radius-md);
  overflow: hidden;
  border: none;
  margin: 8px 0;
}

.code-header {
  background: var(--bg-code-header);
  padding: 6px 14px;
  font-size: var(--text-xs);
  font-family: var(--font-mono);
  color: var(--text-tertiary);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.code-body {
  background: var(--bg-code);
  padding: 14px;
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  line-height: 1.7;
  color: var(--text-code);
  overflow-x: auto;
}

/* 行内代码 */
code, .inline-code {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  background: var(--bg-panel);
  padding: 2px 6px;
  border-radius: 4px;
  color: var(--text-primary);
}

/* ========================================
   输入框
   ======================================== */
.input-bar {
  border-radius: var(--radius-xl);
  border: 1px solid var(--border-light);
  background: var(--bg-input);
  box-shadow: var(--shadow-sm);
  padding: 5px 5px 5px 18px;
  display: flex;
  align-items: center;
  gap: 10px;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.input-bar:focus-within {
  border-color: var(--border-focus);
  box-shadow: var(--shadow-md);
}

.input-bar input {
  flex: 1;
  border: none;
  outline: none;
  font-size: var(--text-md);
  font-family: var(--font-sans);
  color: var(--text-primary);
  background: transparent;
}

.input-bar input::placeholder {
  color: var(--text-placeholder);
}

/* 通用文本输入 */
.input-text {
  padding: 8px 14px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-light);
  background: var(--bg-input);
  font-size: var(--text-md);
  font-family: var(--font-sans);
  color: var(--text-primary);
  outline: none;
  transition: border-color 0.15s;
}
.input-text:focus {
  border-color: var(--border-focus);
}
.input-text::placeholder {
  color: var(--text-placeholder);
}

/* 说明：
   下面这些“聊天布局/侧边栏/任务列表”通用类名与项目现有组件（ChatTab/TaskBoard 等）同名，
   会覆盖原布局导致输入框/滚动/右侧面板异常，因此不在全局层定义。 */

/* ========================================
   区域分隔（用背景色替代线条）
   ======================================== */
.card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: 16px 20px;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-subtle);
}

.card-inset {
  background: var(--bg-panel);
  border-radius: var(--radius-md);
  padding: 12px 16px;
}

/* 分隔线（极少使用） */
.divider {
  border: none;
  border-top: 1px solid var(--border-subtle);
  margin: 12px 0;
}

/* ========================================
   字体层级
   ======================================== */
h1 {
  font-size: var(--text-3xl);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.3;
  font-family: var(--font-display);
}
h2 {
  font-size: var(--text-xl);
  font-weight: 600;
  letter-spacing: -0.01em;
}
h3 {
  font-size: var(--text-lg);
  font-weight: 600;
}

.text-caption {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
}

/* ========================================
   Tooltip
   ======================================== */
.tooltip {
  background: var(--bg-tooltip);
  color: var(--text-inverse);
  padding: 6px 12px;
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  box-shadow: var(--shadow-md);
}

/* 浅色主题 tooltip 文字反色 */
[data-color-scheme="light"] .tooltip {
  color: var(--text-inverse);
}

/* ========================================
   Overlay / Modal
   ======================================== */
.overlay {
  position: fixed;
  inset: 0;
  background: var(--bg-overlay);
  z-index: 100;
}

.modal {
  background: var(--bg-elevated);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  padding: 24px;
  max-width: 480px;
  margin: auto;
}

/* ========================================
   优先级颜色（任务用）
   ======================================== */
.priority-p0 { color: var(--priority-p0); }
.priority-p1 { color: var(--priority-p1); }
.priority-p2 { color: var(--priority-p2); }

/* ========================================
   Glow 效果（仅深色主题生效）
   ======================================== */
[data-color-scheme="dark"] .glow {
  box-shadow: var(--shadow-glow);
}
[data-color-scheme="dark"] .glow-text {
  text-shadow: 0 0 12px var(--glow-color);
}

/* 浅色主题不要 glow */
[data-color-scheme="light"] .glow,
[data-color-scheme="light"] .glow-text {
  box-shadow: none;
  text-shadow: none;
}

